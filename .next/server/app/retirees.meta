{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/retirees/layout,_N_T_/retirees/page,_N_T_/retirees"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/retirees/__PAGE__",
    "/retirees",
    "/_index",
    "/_head"
  ]
}