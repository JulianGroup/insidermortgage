# Apache config for DreamHost shared hosting (copied into out/ by next build)
ErrorDocument 404 /404.html
DirectoryIndex index.html

# Redirect legacy /self-employed URLs to /self-employed-programs/
RedirectMatch 301 ^/self-employed/?$ /self-employed-programs/

# Redirect case variations of Prop 19 calculator to canonical /CAprop-19-calculator/
RedirectMatch 301 ^/(?:ca-prop-19-calculator|caprop-19-calculator|prop19-calculator)/?$ /CAprop-19-calculator/
