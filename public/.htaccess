# Apache config for DreamHost shared hosting (copied into out/ by next build)
ErrorDocument 404 /404.html
DirectoryIndex index.html

RewriteEngine On

# 1a. Consolidate www or HTTP on extensionless paths directly to https://insidermortgage.com/path/ in 1 hop
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{HTTP_HOST} ^www\.insidermortgage\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(?:www\.)?insidermortgage\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
RewriteRule ^(.+)$ https://insidermortgage.com/$1/ [L,R=301]

# 1b. Consolidate remaining www or HTTP requests (root /, trailing-slashed paths, or static files) in 1 hop
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{HTTP_HOST} ^www\.insidermortgage\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(?:www\.)?insidermortgage\.com$ [NC]
RewriteCond %{REQUEST_URI} !\.php$
RewriteRule ^(.*?)(?:index\.html)?$ https://insidermortgage.com/$1 [L,R=301]

# Tag hashed Next.js static assets so mod_headers can apply immutable 1-year caching
RewriteRule ^_next/static/ - [E=IMMUTABLE_STATIC:1]

# Short alias for Rental Property Investment Analyzer (case-insensitive, preserves query string)
RewriteRule ^ra/?$ /tools/rental-analyzer/ [L,R=301,NC]

# Short alias for First-Time Home Buyer Tax Savings Calculator (case-insensitive, preserves query string)
RewriteRule ^tax/?$ /geek-out/first-time-buyer-tax-savings/ [L,R=301,NC]

# Redirect legacy /self-employed URLs to /self-employed-programs/
RedirectMatch 301 ^/self-employed/?$ /self-employed-programs/

# Redirect legacy /dscr-loans to /investor-loans/
RedirectMatch 301 ^/dscr-loans/?$ /investor-loans/

# Redirect case variations of Prop 19 calculator to canonical /CAprop-19-calculator/
RedirectMatch 301 ^/(?:ca-prop-19-calculator|caprop-19-calculator|prop19-calculator)/?$ /CAprop-19-calculator/

# Redirect retired homepage variations (v2, v4, v5, v6 duplicate route, v7, home-backup) to primary root /
RedirectMatch 301 ^/(?:home-v(?:2|4|5|6|7)|home-backup)/?$ /

# Browser Cache Lifetimes
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_STATIC
  Header set Cache-Control "public, max-age=31536000, immutable" env=REDIRECT_IMMUTABLE_STATIC

  <FilesMatch "\.(html|json|xml|php)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  <Files "google-reviews-widget.js">
    Header set Cache-Control "public, max-age=3600"
  </Files>
</IfModule>

# Gzip/Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
